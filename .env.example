# Copie este arquivo para .env e ajuste se necessário (nunca commitar o .env real).
# Valores abaixo são fictícios, apenas para desenvolvimento local (CLAUDE.md secao 0.3).

# ---- PostgreSQL ----
POSTGRES_USER=rpe
POSTGRES_PASSWORD=rpe
POSTGRES_DB=rpe

# ---- JWT (segredo compartilhado: Portador emite, Produto e Cartao validam) ----
JWT_SECRET=dev-only-insecure-secret-troque-em-producao-32chars
JWT_ISSUER=https://portador-service.rpe.local
JWT_AUDIENCE=rpe-api

# ---- Usuario seed do Portador (POST /api/v1/auth/login) ----
# Apenas para ambiente local/demo (CLAUDE.md secao 6.7) - nao ha cadastro de usuarios nesta fase.
# Credenciais padrao (ja embutidas como default no application.yml do portador-service):
#   username: admin
#   senha:    admin123
# Para trocar, gere um novo hash BCrypt e sobrescreva AUTH_SEED_USERNAME / AUTH_SEED_PASSWORD_HASH
# como variaveis de ambiente do container (nao via docker-compose.yml/.env: um hash BCrypt comeca
# com "$2a$10$..." e o "$" e reinterpolado pelo parser do Compose, corrompendo o valor).

# ---- Portas expostas no host ----
PRODUTO_SERVICE_PORT=8081
PORTADOR_SERVICE_PORT=8082
CARTAO_SERVICE_PORT=8083
